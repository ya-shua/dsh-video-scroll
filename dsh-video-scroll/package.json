{
  "name": "dsh-video-scroll",
  "version": "1.5.0",
  "description": "DSH 插件（合并版）：刷B站 + 刷抖音，一个统一入口 + 浏览器全功能综合面板 —— 每天替你各刷一轮，读内容挑出值得的、写日报、值得的就 @ 你",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "douyin",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./bili": "./bili/index.js",
    "./douyin": "./douyin/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "build-client.mjs",
    "selfcheck.mjs",
    "console",
    "bili",
    "douyin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "upstreams": {
    "bili": "https://github.com/c1overzz/dsh-bili-scroll (v2.3.1, MIT)",
    "douyin": "https://github.com/NEWJO123/dsh-douyin-scroll (v0.5.4, MIT)"
  }
}
